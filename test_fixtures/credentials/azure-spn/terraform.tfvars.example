# Copy to terraform.tfvars and edit. All have working defaults — override as needed.
# subscription_id      = null            # null = current `az login` subscription
# spn_display_name     = "prooflayer-scanner"
# role                 = "Reader"         # subscription-scope ARM role for the SPN
# secret_validity_months = 12
# graph_application_permissions = ["User.Read.All", "Group.Read.All", "Device.Read.All"]
