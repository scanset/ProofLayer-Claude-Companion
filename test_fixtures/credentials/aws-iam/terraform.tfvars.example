# Copy to terraform.tfvars and edit.
credential_kind = "assume_role"          # "assume_role" (recommended) or "access_key"
# iam_name      = "prooflayer-scanner"
# region        = "us-east-1"            # default-region metadata only; doesn't restrict scanning
# managed_policy_arns = ["arn:aws:iam::aws:policy/SecurityAudit", "arn:aws:iam::aws:policy/job-function/ViewOnlyAccess"]
# trusted_principal_arns = []            # who may assume the role (assume_role mode)
# external_id   = ""                     # blank = auto-generated
