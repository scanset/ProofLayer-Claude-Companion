# Copy to terraform.tfvars and edit. Defaults work as-is for a throwaway eval.
# location              = "eastus"
# subscription_id       = ""                    # blank = ambient `az login` context
# name_prefix           = "prooflayer-eval"
# allowed_cidr          = "203.0.113.4/32"      # the appliance's egress IP — recommended over 0.0.0.0/0
# linux_vm_size         = "Standard_B1s"
# windows_vm_size       = "Standard_B2s"
# For Rocky 9 instead of RHEL 9, set the resf Marketplace image (and add an
# azurerm_marketplace_agreement + plan block in main.tf):
# rhel_publisher        = "resf"
# rhel_offer            = "rockylinux-x86_64"
# rhel_sku              = "9-base"
